# ===========================================
# TradingAgents Environment Configuration
# ===========================================

# LLM Providers (set the one you use)
# For Chinese users, Dashscope (Qwen) is recommended
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=

# Data Sources
# AKShare is recommended for Chinese users (free, no API key required)
# Alpha Vantage is an alternative (requires API key)
ALPHA_VANTAGE_API_KEY=

# Optional: Tushare for additional A-share data (requires registration)
# Register at: https://tushare.pro/register
TUSHARE_TOKEN=

# Optional: Proxy settings for accessing blocked services
# If you're in China and need to access yfinance or other blocked services
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# Results directory (optional)
# TRADINGAGENTS_RESULTS_DIR=./results
